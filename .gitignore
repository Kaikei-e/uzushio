# The built binary. `make build` writes it; nothing reads it back.
/bin/

# scratch file of go generate in internal/surfaces
*.tmp

# An example task's generated git repository, and what a health check writes.
# setup.sh builds repo/ from src/; `uzushio task doctor` writes doctor/, which
# holds the verifier's own output and so carries absolute paths from whichever
# machine ran it. Neither belongs in a public repository.
/examples/*/repo/
/examples/*/doctor/

# The suite's tasks are one level deeper than examples/task-hello, so the
# patterns above do not reach them. runs/ is what `cmoa propose` and
# `cmoa select` write; it carries absolute paths too.
/examples/suite-go/*/repo/
/examples/suite-go/*/runs/
/examples/suite-go/*/doctor/

# What `cmoa judge` writes beside a chat calibration item. The suite and its
# gold labels are committed; the traces of one judge run are not — they hold
# the whole prompt and the raw model answers, and the calibration's own
# report.json carries the numbers a reader needs.
/examples/suite-chat/*/runs/

# What `uzushio run` writes: the rendered harness trees, the per-trial journal,
# the run header, and the baseline cache it shares between sibling runs. The
# default --out is <suite dir>/runs/<run-id> and the cache is <suite dir>/cache,
# so both live beside whichever suite was measured. They carry trace paths and
# the harness's own stderr, so neither belongs in a public repository.
/runs/
/cache/
/examples/*/cache/
/examples/suite-go/cache/
/examples/suite-go/runs/
