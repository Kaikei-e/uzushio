# The built binary. `make build` writes it; nothing reads it back.
/bin/

# scratch file of go generate in internal/surfaces
*.tmp

# An example task's generated git repository, and what a health check writes.
# setup.sh builds repo/ from src/; `uzushio task doctor` writes doctor/, which
# holds the verifier's own output and so carries absolute paths from whichever
# machine ran it. Neither belongs in a public repository.
/examples/*/repo/
/examples/*/doctor/

# The suite's tasks are one level deeper than examples/task-hello, so the
# patterns above do not reach them. runs/ is what `cmoa propose` and
# `cmoa select` write; it carries absolute paths too.
/examples/suite-go/*/repo/
/examples/suite-go/*/runs/
/examples/suite-go/*/doctor/

# The chat calibration suites. What is committed is the human part: the
# manifest, and per item task.json, conversation.json, gold.json and rubric.md.
#
# `candidates/` is not. Those files hold responses generated by language
# models, and a model's output is subject to its provider's terms of use
# whatever licence the surrounding dataset carries — so this repository does
# not redistribute them. They are fetched onto the machine that needs them by
# `uzushio judge import-mtbench --candidates-only`, which reproduces exactly
# the items the manifest lists from the same seed. `judge calibrate` refuses
# to start without them and says so.
#
# `runs/` is what `cmoa judge` writes beside an item: the whole prompt and the
# raw model answers again, plus absolute paths from whichever machine ran it.
/examples/suite-chat/*/candidates/
/examples/suite-chat/*/runs/
/examples/suite-chat-ja/*/candidates/
/examples/suite-chat-ja/*/runs/

# What `uzushio run` writes: the rendered harness trees, the per-trial journal,
# the run header, and the baseline cache it shares between sibling runs. The
# default --out is <suite dir>/runs/<run-id> and the cache is <suite dir>/cache,
# so both live beside whichever suite was measured. They carry trace paths and
# the harness's own stderr, so neither belongs in a public repository.
/runs/
/cache/
/examples/*/cache/
/examples/suite-go/cache/
/examples/suite-go/runs/

# What `uzushio judge trial` writes beside a card, and the local harness
# configuration a card names. A trial output holds run directories and the
# harness's own stderr; a configuration lives wherever its owner keeps it and
# is a placeholder in every committed card (see examples/suite-chat/cards).
/examples/suite-chat/cards/trial-*/
/examples/suite-chat/cards/cmoa-*.json

# Local saved-response comparison reports contain generated run details.
/examples/suite-chat/cards/*-saved-comparison-*/

# Private P1 evaluation data includes synthetic pilot content, its generators,
# anonymized packets, human labels, holdout membership and execution artifacts.
/local/
/docs/internal/
/data/
/datasets/
/evaluation-data/
/private/
/examples/p1-chat/
/examples/p1-code/
**/label-packets/
**/holdout-registry/
**/assessment-*/
**/packet.md
**/mapping.json
**/answers.json
**/annotations.json
