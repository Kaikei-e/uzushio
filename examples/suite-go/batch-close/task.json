{
  "version": 2,
  "id": "batch-close",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "batch.go",
    "batch_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-deferred-to-the-end.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "batch.go: closing is deferred, so every batch stays open until Total returns"
    },
    {
      "diff": "mutants/0002-closed-before-it-is-read.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "batch.go: the batch is closed before its size is read, so it counts as empty"
    },
    {
      "diff": "mutants/0003-previous-batch-closed.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "batch.go: each batch is closed when the next one opens, so the last one is left open"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
