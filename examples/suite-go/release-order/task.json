{
  "version": 2,
  "id": "release-order",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "order.go",
    "order_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-one-or-instead-of-two-levels.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "order.go: one boolean or instead of two levels, which can call each of two releases the earlier one"
    },
    {
      "diff": "mutants/0002-names-descending.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "order.go: releases on one day are ordered by name backwards"
    },
    {
      "diff": "mutants/0003-oldest-day-first.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "order.go: the oldest day is listed first"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
