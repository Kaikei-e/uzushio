{
  "version": 2,
  "id": "cursor-pagination",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "page.go",
    "page_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-next-past-the-end.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "page.go: a page that ends exactly on the last id still reports a next cursor"
    },
    {
      "diff": "mutants/0002-short-page.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "page.go: the window is one id short"
    },
    {
      "diff": "mutants/0003-next-skips-an-id.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "page.go: the next cursor skips the first id of the following page"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
