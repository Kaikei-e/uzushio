{
  "version": 2,
  "id": "object-key",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "key.go",
    "key_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-plain-join.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "key.go: the parts are pasted together, so an empty part doubles a separator"
    },
    {
      "diff": "mutants/0002-leading-separator-kept.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "key.go: a key built from an absolute-looking part keeps its leading separator"
    },
    {
      "diff": "mutants/0003-trims-both-ends.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "key.go: stray separators are trimmed off the ends but not cleaned inside"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
