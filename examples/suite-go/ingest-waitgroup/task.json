{
  "version": 2,
  "id": "ingest-waitgroup",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "sum.go",
    "sum_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-counter-raised-once.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "sum.go: the counter is raised once for the whole loop, so Wait returns after the first result"
    },
    {
      "diff": "mutants/0002-total-unguarded.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "sum.go: the total is added to without the lock, which is a data race"
    },
    {
      "diff": "mutants/0003-nothing-waited-for.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "sum.go: Sum does not wait, and reads the total while the goroutines are still writing it"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
