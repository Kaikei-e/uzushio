{
  "version": 2,
  "id": "config-loader",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "config.go",
    "config_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-not-wrapped.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "config.go: the sentinel is formatted rather than wrapped, so errors.Is says no"
    },
    {
      "diff": "mutants/0002-value-returned-with-the-error.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "config.go: a value is returned alongside the error instead of the empty string"
    },
    {
      "diff": "mutants/0003-key-dropped.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "config.go: the error wraps the sentinel but drops the key from the message"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
