{
  "version": 2,
  "id": "leaderboard-rank",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "rank.go",
    "rank_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-unstable-sort.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "rank.go: an unstable sort reorders players who are level"
    },
    {
      "diff": "mutants/0002-lowest-first.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "rank.go: the board is ordered lowest score first"
    },
    {
      "diff": "mutants/0003-sorts-the-argument.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "rank.go: the caller's slice is sorted in place instead of a copy"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
