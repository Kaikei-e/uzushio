{
  "version": 2,
  "id": "retry-backoff",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "backoff.go",
    "backoff_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-doubles-without-a-cap.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "backoff.go: doubling is not stopped at max, so a large attempt overflows"
    },
    {
      "diff": "mutants/0002-guards-the-wrong-attempt.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "backoff.go: guards attempts above 62, but 62 shifts already overflow"
    },
    {
      "diff": "mutants/0003-no-final-cap.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "backoff.go: the doubled delay is never capped at max"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
