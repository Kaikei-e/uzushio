{
  "version": 2,
  "id": "tag-index",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "index.go",
    "index_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-no-guard.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "index.go: the first Add on a zero index writes to a nil map and panics"
    },
    {
      "diff": "mutants/0002-guarded-on-the-reading-side.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "index.go: the guard is written but Add still writes to a nil map"
    },
    {
      "diff": "mutants/0003-map-rebuilt-each-time.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "index.go: every Add starts a new map, so only the last id survives"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
