{
  "version": 2,
  "id": "audit-buffer",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "buffer.go",
    "buffer_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-shared-storage.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "buffer.go: appends in place, so two lists grown from one share storage"
    },
    {
      "diff": "mutants/0002-entry-dropped.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "buffer.go: the copy is made but the new entry is never added"
    },
    {
      "diff": "mutants/0003-blank-slot.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "buffer.go: the copy leaves a blank entry before the appended one"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
