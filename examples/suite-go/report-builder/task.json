{
  "version": 2,
  "id": "report-builder",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "render.go",
    "render_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-never-reset.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "render.go: the builder is reused, so each section carries the ones before it"
    },
    {
      "diff": "mutants/0002-reset-after-the-heading.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "render.go: the reset lands after the heading, which throws the heading away"
    },
    {
      "diff": "mutants/0003-reset-before-reading.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "render.go: the section is emptied before it is returned"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
