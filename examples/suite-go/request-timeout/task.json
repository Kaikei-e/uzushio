{
  "version": 2,
  "id": "request-timeout",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "wait.go",
    "wait_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-context-ignored.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "wait.go: the context is never watched, so a caller that gives up is not answered"
    },
    {
      "diff": "mutants/0002-work-ignored.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "wait.go: only the context is watched, so finished work is not noticed"
    },
    {
      "diff": "mutants/0003-cancellation-looks-like-success.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "wait.go: giving up is reported as the work having finished"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
