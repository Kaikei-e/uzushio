{
  "version": 2,
  "id": "export-csv",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "row.go",
    "row_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-nothing-quoted.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "row.go: no field is ever quoted, so a comma inside one splits the record"
    },
    {
      "diff": "mutants/0002-inner-quotes-not-doubled.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "row.go: a quote inside a quoted field is not doubled"
    },
    {
      "diff": "mutants/0003-everything-quoted.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "row.go: every field is quoted, including the ones that need no quoting"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
