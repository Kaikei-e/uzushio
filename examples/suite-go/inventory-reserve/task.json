{
  "version": 2,
  "id": "inventory-reserve",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "reserve.go",
    "reserve_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-accepts-zero.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "reserve.go: a reservation of zero units is accepted"
    },
    {
      "diff": "mutants/0002-refuses-the-whole-stock.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "reserve.go: taking exactly the remaining stock is refused"
    },
    {
      "diff": "mutants/0003-no-overdraw-guard.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "reserve.go: a reservation larger than the stock is accepted and the level goes negative"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
