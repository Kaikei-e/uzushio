{
  "version": 2,
  "id": "iso-week",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "label.go",
    "label_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-calendar-year.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "label.go: the calendar year is reported instead of the week-numbering year"
    },
    {
      "diff": "mutants/0002-week-counted-by-hand.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "label.go: the week is counted off the day of the year rather than read"
    },
    {
      "diff": "mutants/0003-swapped.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "label.go: the year and the week come back the wrong way round"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
