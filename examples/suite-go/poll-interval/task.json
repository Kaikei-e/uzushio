{
  "version": 2,
  "id": "poll-interval",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "interval.go",
    "interval_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-nanoseconds.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "interval.go: the answer is a count of nanoseconds rather than a minute divided up"
    },
    {
      "diff": "mutants/0002-second-not-minute.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "interval.go: the rate is read as polls per second"
    },
    {
      "diff": "mutants/0003-rounded-to-seconds.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "interval.go: the division is done in whole seconds, so 7 polls a minute lose the remainder"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
