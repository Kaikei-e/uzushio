{
  "version": 2,
  "id": "usage-share",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "share.go",
    "share_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-integer-division.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "share.go: the division happens in whole numbers, so 1 of 2 is 0%"
    },
    {
      "diff": "mutants/0002-no-zero-guard.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "share.go: a total of zero divides by zero and answers NaN"
    },
    {
      "diff": "mutants/0003-fraction-not-percent.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "share.go: the share is a fraction rather than a percentage"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
