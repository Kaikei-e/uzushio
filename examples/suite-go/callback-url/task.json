{
  "version": 2,
  "id": "callback-url",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "callback.go",
    "callback_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-pasted-together.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "callback.go: the values are pasted into the query unescaped"
    },
    {
      "diff": "mutants/0002-only-the-state-escaped.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "callback.go: only one of the two values is escaped"
    },
    {
      "diff": "mutants/0003-path-escaping.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "callback.go: path escaping is used, which leaves & and = alone in a query"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
