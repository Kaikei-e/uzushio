{
  "version": 2,
  "id": "version-compare",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "compare.go",
    "compare_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-text-order.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "compare.go: no component is compared, so every version looks the same"
    },
    {
      "diff": "mutants/0002-major-only.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "compare.go: only the major component is compared"
    },
    {
      "diff": "mutants/0003-order-reversed.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "compare.go: the answer is the wrong way round"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
