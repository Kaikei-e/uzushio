{
  "version": 2,
  "id": "name-match",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "match.go",
    "match_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-lowered-not-folded.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "match.go: both names are lowered, which is not case folding"
    },
    {
      "diff": "mutants/0002-not-trimmed.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "match.go: surrounding spaces are compared as part of the name"
    },
    {
      "diff": "mutants/0003-uppercased.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "match.go: both names are uppercased, which merges letters case folding keeps apart"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
