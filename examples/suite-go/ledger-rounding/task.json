{
  "version": 2,
  "id": "ledger-rounding",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "rounding.go",
    "rounding_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-floor.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "rounding.go: rounds down instead of away from zero, so 0.125 becomes 12 cents"
    },
    {
      "diff": "mutants/0002-half-to-even.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "rounding.go: rounds halves to the even cent, so 0.125 becomes 12 cents"
    },
    {
      "diff": "mutants/0003-add-half-then-floor.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "rounding.go: adds a half and floors, which rounds negative halves towards zero"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
