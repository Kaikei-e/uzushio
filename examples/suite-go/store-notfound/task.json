{
  "version": 2,
  "id": "store-notfound",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "store.go",
    "store_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-equality.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "store.go: the wrapped error is compared with ==, which never matches"
    },
    {
      "diff": "mutants/0002-arguments-swapped.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "store.go: errors.Is is asked whether the sentinel wraps the error"
    },
    {
      "diff": "mutants/0003-every-failure-defaults.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "store.go: every failure falls back to the default, not only a missing record"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
