{
  "version": 2,
  "id": "session-cache",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "cache.go",
    "cache_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-no-cache-check.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "cache.go: only the session is checked, so a nil cache panics"
    },
    {
      "diff": "mutants/0002-no-session-check.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "cache.go: only the cache is checked, so an unknown id panics"
    },
    {
      "diff": "mutants/0003-missing-means-yes.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "cache.go: an absent session is reported as carrying every role"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
