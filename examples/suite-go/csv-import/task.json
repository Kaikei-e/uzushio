{
  "version": 2,
  "id": "csv-import",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "clean.go",
    "clean_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-mark-kept.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "clean.go: the byte order mark is left on the field"
    },
    {
      "diff": "mutants/0002-not-trimmed.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "clean.go: surrounding whitespace is left on the field"
    },
    {
      "diff": "mutants/0003-trimmed-before-the-mark.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "clean.go: the mark is stripped after trimming, so a mark followed by a space keeps the space"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
