{
  "version": 2,
  "id": "shift-scheduler",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "day.go",
    "day_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-zone-of-the-timestamp.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "day.go: the calendar date is read in the timestamp's own zone"
    },
    {
      "diff": "mutants/0002-utc-date.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "day.go: the calendar date is read in UTC rather than in loc"
    },
    {
      "diff": "mutants/0003-wrong-zone-on-the-result.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "day.go: the right date is built in the timestamp's zone instead of loc"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
