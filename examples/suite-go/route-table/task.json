{
  "version": 2,
  "id": "route-table",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "table.go",
    "table_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-lookup-not-folded.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "table.go: only Add folds the method's case, so a lower-case lookup misses"
    },
    {
      "diff": "mutants/0002-add-not-folded.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "table.go: only Lookup folds the method's case, so a lower-case registration misses"
    },
    {
      "diff": "mutants/0003-path-folded-too.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "table.go: the path is folded as well, so /orders matches a route registered for /Orders"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
