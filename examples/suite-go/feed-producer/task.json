{
  "version": 2,
  "id": "feed-producer",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "stream.go",
    "stream_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-never-closed.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "stream.go: the channel is never closed, so a range over it never ends"
    },
    {
      "diff": "mutants/0002-closed-before-sending.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "stream.go: the channel is closed before anything is sent"
    },
    {
      "diff": "mutants/0003-only-the-first-item.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "stream.go: only the first item is sent before the channel is closed"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
