{
  "version": 2,
  "id": "price-lookup",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "tier.go",
    "tier_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-strict-loop.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "tier.go: the search stops one step early and misses the last tier"
    },
    {
      "diff": "mutants/0002-strict-minimum.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "tier.go: a quantity exactly on a tier's minimum falls into the tier below"
    },
    {
      "diff": "mutants/0003-low-jumps-two.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "tier.go: the lower bound skips a tier on each step"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
