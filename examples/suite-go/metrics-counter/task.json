{
  "version": 2,
  "id": "metrics-counter",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "counter.go",
    "counter_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-read-unguarded.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "counter.go: only Inc takes the lock, so a concurrent Get races"
    },
    {
      "diff": "mutants/0002-write-unguarded.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "counter.go: only Get takes the lock, so concurrent increments race"
    },
    {
      "diff": "mutants/0003-unlocked-too-early.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "counter.go: Inc releases the lock before it writes, so the map is written unguarded"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
