{
  "version": 2,
  "id": "json-field-tag",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "invoice.go",
    "invoice_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-customer-tag-dropped.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "invoice.go: Customer loses its tag, so it is encoded as \"Customer\""
    },
    {
      "diff": "mutants/0002-amount-tag-shortened.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "invoice.go: the amount is read from the wrong JSON name and stays zero"
    },
    {
      "diff": "mutants/0003-paid-tag-capitalised.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "invoice.go: the paid flag is encoded under a capitalised name"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
