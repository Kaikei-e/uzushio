{
  "version": 2,
  "id": "event-ring",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "ring.go",
    "ring_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-not-rotated.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "ring.go: the buffer is returned as it lies, so after a wrap the oldest event is not first"
    },
    {
      "diff": "mutants/0002-rotated-the-wrong-way.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "ring.go: the two halves are joined in the wrong order"
    },
    {
      "diff": "mutants/0003-second-half-dropped.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "ring.go: only the older half is returned, so the newest events are lost"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
