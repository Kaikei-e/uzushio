{
  "version": 2,
  "id": "worker-fanout",
  "repo": "repo",
  "rev": "HEAD",
  "files": [
    "fanout.go",
    "fanout_test.go"
  ],
  "verify": {
    "compose_file": "compose.yaml",
    "service": "verify",
    "kind": "exit-code",
    "timeout_seconds": 600
  },
  "reference": {
    "diff": "reference.diff"
  },
  "mutants": [
    {
      "diff": "mutants/0001-one-shared-variable.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "fanout.go: every handler closes over one variable, so they all report the last shard"
    },
    {
      "diff": "mutants/0002-shared-index.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "fanout.go: the handlers share one index, which has run past the end by the time they are called"
    },
    {
      "diff": "mutants/0003-reversed.diff",
      "expect": "killed",
      "origin": "hand",
      "note": "fanout.go: the handlers come back in the opposite order to the shards"
    }
  ],
  "doctor": {
    "kill_rate_min": 0.8,
    "reference_runs": 2
  }
}
